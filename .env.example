# Copy to .env and fill in. Do NOT commit .env.
# ------------------------------------------------

# InstantDB — self-hosted on realm-cloud (dashboard https://instant-dash.aws.realm.watch).
# Leave blank to use the defaults in app.config.ts.
INSTANT_APP_ID=
INSTANT_API_URI=
INSTANT_WEBSOCKET_URI=
# Admin token — only needed for seed:listings (bypasses auth). Dashboard → App → Admin token.
INSTANT_ADMIN_TOKEN=

# Google Maps — enable Maps SDK (iOS), Maps SDK (Android),
# Places API, Geocoding API in Google Cloud Console.
# Restrict each key by bundle ID + SHA-1.
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=
# Web Maps key — restrict to HTTP referrers (your Pages URL + localhost)
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
